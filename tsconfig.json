{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@pages/*": [
        "./src/ui/pages/*"
      ],
      "@renderer-features/*": [
        "./src/ui/features/*"
      ],
      "@renderer-shared/*": [
        "./src/ui/shared/*"
      ],
      "@renderer/*": [
        "./src/ui/*"
      ],
      "@widgets/*": [
        "./src/ui/widgets/*"
      ],
    }
  }
}