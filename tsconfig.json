{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": "./",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "*": [
        "node_modules/*"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@pages/*": [
        "./src/renderer/pages/*"
      ],
      "@renderer-features/*": [
        "./src/renderer/features/*"
      ],
      "@renderer-shared/*": [
        "./src/renderer/shared/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@widgets/*": [
        "./src/renderer/widgets/*"
      ],
    }
  },
  "include": [
    "src/**/*",
  ]
}